# TypeScript API (apps/api) for the contact form's POST /api/contact (VAY-2286).
#   portless default:  https://api.localhost
#   plain-port dev:    http://localhost:8003
#   production:        https://next-api.vayada.com
# NEXT_PUBLIC_API_URL=

# TypeScript Vayada API. No page reads it since the Marketplace pages were
# removed (VAY-2260); the build argument stays until the deploy drops it.
#   portless default:  https://api.localhost
#   plain-port dev:    http://localhost:8003
#   production:        https://next-api.vayada.com
# NEXT_PUBLIC_VAYADA_API_URL=

# PMS frontend (deep-link target for the product chooser → PMS login)
# Default in code: https://pms.vayada.com (prod).
#   portless dev:      https://pms.localhost
#   plain-port dev:    http://localhost:3004
NEXT_PUBLIC_PMS_URL=https://pms.vayada.com

# Authenticated app (Booking Admin) — Sign up / Log in links from this site
# Default in code: https://next-booking-admin.vayada.com (prod).
#   portless dev:      https://admin.booking.localhost
#   plain-port dev:    http://localhost:3003
NEXT_PUBLIC_APP_URL=https://next-booking-admin.vayada.com

# Node Environment
# Set to 'development' for local development, 'production' for production builds
NODE_ENV=development

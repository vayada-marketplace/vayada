# Server-only first-party /auth gateway settings (kept for the login gateway contract).
#   portless public origin: https://marketplace.localhost
#   plain-port public origin: http://localhost:3000
# AUTH_PUBLIC_ORIGIN=
# AUTH_GATEWAY_UPSTREAM_ORIGIN=http://127.0.0.1:8003

# Where hotel routes forward. Default in code: https://next-booking-admin.vayada.com
#   portless dev:      https://admin.booking.localhost
#   plain-port dev:    http://localhost:3003
# NEXT_PUBLIC_BOOKING_ADMIN_URL=

# Where everything else forwards. Default in code: https://vayada.com
# NEXT_PUBLIC_MARKETING_URL=
